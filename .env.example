# ---------------------------------------------------------------------------
# Supabase Postgres connection string
# ---------------------------------------------------------------------------
# Replace the placeholders with the values from your Supabase project:
#   Dashboard -> Project Settings -> Database -> Connection string
#
# Password characters such as @ : / ? # [ ] must be URL-encoded
# (for example: p@ssw0rd -> p%40ssw0rd).
#
# Option A - Transaction pooler (recommended: IPv4-compatible, great for
#            short-lived MCP processes). Port 6543.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require

# Option B - Direct connection (IPv6 only by default; supports session-level
#            features). Port 5432.
# DATABASE_URL=postgresql://postgres:<YOUR_DB_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require

# Option C - Session pooler (IPv4-compatible, session-level features). Port 5432.
# DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<YOUR_DB_PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require

# ---------------------------------------------------------------------------
# Optional settings (defaults shown)
# ---------------------------------------------------------------------------
# Allow the "execute" tool to run INSERT/UPDATE/DELETE/DDL statements.
# When false (default), the tool is not registered at all.
# ALLOW_WRITES=false

# Default and maximum number of rows returned by a single query.
# MAX_ROWS=100

# Server-side statement timeout in milliseconds.
# STATEMENT_TIMEOUT_MS=15000

# Maximum number of pooled connections.
# POOL_MAX=5

# TCP connect timeout in seconds.
# CONNECT_TIMEOUT_S=10

# Name reported to Postgres in pg_stat_activity.
# APPLICATION_NAME=supabase-postgres-mcp
